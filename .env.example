PORT=3000

# SQLite database file (relative to project root)
DATABASE_URL=file:./dev.db

AI_ENGINE_BASE_URL=http://127.0.0.1:8000
AI_ENGINE_TIMEOUT_MS=120000

LLM_PROVIDER=deepseek
LLM_API_KEY=your_api_key_here
LLM_MODEL=deepseek-v4-pro
LLM_BASE_URL=https://api.deepseek.com
LLM_TIMEOUT_MS=30000
LLM_MAX_OUTPUT_TOKENS=1000

# Offline OCR (scanned PDF / images) — see README
OCR_ENABLED=true
OCR_PDF_MAX_PAGES=30
OCR_PDF_SCALE=2
# OCR_LANG_PATH=data/tessdata/4.0.0

# Optional legacy compatibility
# OPENAI_API_KEY=
# OPENAI_MODEL=
# OPENAI_BASE_URL=
